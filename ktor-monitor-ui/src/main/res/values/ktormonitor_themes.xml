<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The monitor's own theme, so the app's (an action bar, a splash screen) never shows through. -->
    <style name="ktormonitor_Theme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFFFFFFF</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
